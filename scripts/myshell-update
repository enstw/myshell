#!/usr/bin/env bash
set -euo pipefail

# Update all installed package managers, plugins, and clean up.
# Deployed to ~/bin/myshell-update by scripts/install; invoked via the
# `u` alias. The namespaced name avoids clobbering any personal
# ~/bin/update the user may already have.
#
# Sections are independent and fail soft (`|| warn`): one flaky updater
# must not abort the rest — this is a convenience sweep, not a transaction.
# Warnings are counted and reported in the final Done line.

# Output vocabulary — deliberately duplicated byte-identical in ../bootstrap
# and ./install (this file is deployed standalone to ~/bin, so no sourced
# lib can reach all three); drift between the copies is a bug.
WARNINGS=0
log()    { printf '\n==> %s\n' "$*"; }
sublog() { printf '    %s\n' "$*"; }
warn()   { printf 'warning: %s\n' "$*" >&2; WARNINGS=$((WARNINGS+1)); }
die()    { printf 'error: %s\n' "$*" >&2; exit 1; }
trap 'rc=$?; printf "error: failed at line %s: %s (exit %s)\n" "$LINENO" "$BASH_COMMAND" "$rc" >&2; exit "$rc"' ERR

# sudo shim — same convention as bootstrap: root needs no prefix; non-root
# without sudo skips system-level updates (user-level ones still run).
if [[ $EUID -eq 0 ]]; then
    SUDO=""
    NO_SUDO=0
elif command -v sudo >/dev/null 2>&1; then
    SUDO=sudo
    NO_SUDO=0
else
    SUDO=""
    NO_SUDO=1
fi

# myshell itself — FIRST, so the rest of this sweep runs under the newest
# maintenance code rather than applying it a run late.
#
# The check is cheap (one `git ls-remote`) and the update is rare, so the
# common case costs a single network round-trip and prints one line.
#
# What gets run is the tarball's `bootstrap`, not scripts/install directly:
# stage 1 owns finding (or installing) a bash 5 to run stage 2 with, and
# /bin/bash on macOS is 3.2. Reusing it keeps that logic in one place.
#
# A recorded checkout is read, never written. `u` must not `git pull` in a
# working tree the user develops in — that would move their branch, fight
# their WIP, and surprise them in a way a package sweep never should. The
# checkout is consulted for exactly one question: is this box's build AHEAD of
# origin (a maintainer who has applied local commits)? If so, refreshing from
# origin would be a downgrade, so we leave it alone.
#
# MYSHELL_SELF_UPDATED guards the exec below against a loop: if the installer
# somehow fails to record the new revision, the re-exec'd copy would otherwise
# find itself stale again and re-update forever.
MYSHELL_REPO_URL="https://github.com/enstw/myshell.git"
MYSHELL_TARBALL="https://github.com/enstw/myshell/archive/refs/heads/main.tar.gz"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/myshell"

self_update_myshell() {
    local remote installed checkout tmp
    if ! command -v git >/dev/null 2>&1; then
        sublog "git not installed — skipping the myshell version check"
        return 0
    fi
    # `|| remote=""`, not a bare assignment: set -e + pipefail turn a failing
    # `git ... | awk` into an aborted sweep, and being offline is normal.
    remote=$(git ls-remote "$MYSHELL_REPO_URL" HEAD 2>/dev/null | awk 'NR==1{print $1}') || remote=""
    if [[ -z "$remote" ]]; then
        warn "could not reach $MYSHELL_REPO_URL — skipping the myshell version check"
        return 0
    fi
    installed=$(cat "$STATE_DIR/installed-commit" 2>/dev/null || true)
    if [[ "$installed" == "$remote" ]]; then
        sublog "myshell up to date (${remote:0:7})"
        return 0
    fi
    # Ahead, not behind: the recorded revision is a descendant of origin's
    # HEAD, so this box already has everything origin does, plus local work.
    # merge-base also exits non-zero when the object is simply unknown to the
    # checkout, which is the right answer here — unknown means not ahead.
    checkout=$(cat "$STATE_DIR/checkout" 2>/dev/null || true)
    if [[ -n "$installed" && -n "$checkout" && -d "$checkout/.git" ]] \
       && git -C "$checkout" merge-base --is-ancestor "$remote" "$installed" 2>/dev/null; then
        sublog "local build ${installed:0:7} is ahead of origin — leaving it alone"
        return 0
    fi
    if [[ -z "$installed" ]]; then
        sublog "installed myshell revision unknown — refreshing to ${remote:0:7}"
    else
        sublog "myshell ${installed:0:7} -> ${remote:0:7} — re-running the installer"
    fi
    tmp=$(mktemp -d) || { warn "mktemp failed — skipping the myshell self-update"; return 0; }
    if ! curl -fsSL "$MYSHELL_TARBALL" | tar xz -C "$tmp"; then
        rm -rf "$tmp"
        warn "myshell download failed — skipping the self-update"
        return 0
    fi
    if [[ ! -f "$tmp/myshell-main/bootstrap" ]]; then
        rm -rf "$tmp"
        warn "myshell tarball has no bootstrap — skipping the self-update"
        return 0
    fi
    if ! sh "$tmp/myshell-main/bootstrap"; then
        rm -rf "$tmp"
        warn "myshell self-update failed — the box keeps its previous install"
        return 0
    fi
    rm -rf "$tmp"
    # Backstop the installer's own record. It writes installed-commit when it
    # can work out its revision, but a box with no git, no network at install
    # time, or a checkout git refuses to read (dubious ownership) leaves the
    # file absent — and an absent record reads as "unknown", which would make
    # every single `u` from then on do a full re-install. We just fetched and
    # applied $remote, so we can say authoritatively what is installed.
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$remote" >"$STATE_DIR/installed-commit"
    # The installer just replaced ~/bin/myshell-update. It unlinks before
    # copying, so THIS running process still holds the old inode and finishes
    # safely — but every section below would be the old code. Hand over to the
    # new copy instead, which re-checks (now up to date) and sweeps once.
    if [[ -x "$HOME/bin/myshell-update" ]]; then
        log "myshell updated — restarting the sweep with the new copy"
        MYSHELL_SELF_UPDATED=1 exec "$HOME/bin/myshell-update"
    fi
}

log "Checking myshell..."
if [[ "${MYSHELL_NO_SELF_UPDATE:-0}" == 1 ]]; then
    sublog "MYSHELL_NO_SELF_UPDATE=1 — skipping"
elif [[ "${MYSHELL_SELF_UPDATED:-0}" == 1 ]]; then
    sublog "just self-updated — continuing with the sweep"
else
    self_update_myshell || warn "myshell version check failed"
fi

if command -v brew &>/dev/null; then
    log "Updating Homebrew packages..."
    # Homebrew 6.0 made "ask mode" (a "Do you want to proceed?" confirmation
    # before upgrading) the default. This is an unattended sweep, so opt out via
    # the documented env var (`brew upgrade --help`: "Ask mode is the default
    # ... unless $HOMEBREW_NO_ASK is set") instead of blocking on the prompt.
    export HOMEBREW_NO_ASK=1
    brew update || warn "brew update failed"
    brew upgrade || warn "brew upgrade failed"
    brew cleanup || warn "brew cleanup failed"
fi

if command -v apt &>/dev/null; then
    if [[ "$NO_SUDO" == "1" ]]; then
        warn "no sudo — skipping apt updates"
    else
        log "Updating apt packages..."
        $SUDO apt update || warn "apt update failed"
        $SUDO apt upgrade -y || warn "apt upgrade failed"
        $SUDO apt autoremove -y || warn "apt autoremove failed"
    fi
fi

if command -v snap &>/dev/null; then
    if [[ "$NO_SUDO" == "1" ]]; then
        warn "no sudo — skipping snap refresh"
    else
        log "Refreshing snaps..."
        $SUDO snap refresh || warn "snap refresh failed"
    fi
fi

# zinit is a zsh *function*, not a binary — `command -v zinit` is always
# false in bash — so key on its install dir instead.
ZINIT_HOME="$HOME/.local/share/zinit/zinit.git"
if [[ -f "$ZINIT_HOME/zinit.zsh" ]]; then
    log "Updating zinit plugins..."
    zsh -ic 'zinit self-update; zinit update --all' || warn "zinit update failed"
fi

# pnpm — refresh the Node LTS runtime, update pnpm itself, then update the
# user's own global packages. Agent updates are handled in their own sections.
#
# Three separate commands, because pnpm 11 refuses to let the generic ones near
# itself. Both refusals were hit on a real Ubuntu box (2026-08-31):
#
#   - `pnpm add -g @pnpm/exe@latest` — what this section used to run to heal a
#     broken pnpm — is now rejected outright:
#         ERR_PNPM_GLOBAL_PNPM_INSTALL
#         Use the "pnpm self-update" command to install or update pnpm
#     That message was the user-visible symptom. self-update is the sanctioned
#     path and replaces it.
#
#   - bare `pnpm update -g` must NEVER run. get.pnpm.io/install.sh records the
#     standalone build as a *linked* dep of its own global project —
#     "@pnpm/exe": "file:/tmp/tmp.XXXXXX" — pointing at the mktemp dir it
#     unpacked into, which is gone the moment the installer exits. `update -g`
#     walks every global project, so on EVERY box installed that way (a
#     minutes-old one included, not just after a /tmp reap) it dies with
#     ERR_PNPM_LINKED_PKG_DIR_NOT_FOUND. Repairing that spec to a registry
#     version makes things worse, not better: the update then re-links
#     @pnpm/exe as an ordinary dep WITHOUT running its setup.js preinstall —
#     the only thing that hardlinks the real binary — so `pnpm` is left as
#     npm's 34-byte placeholder ("pnpm: 1: This: not found") and cannot even
#     self-update out of it. The dangling file: link is what keeps `update -g`
#     off pnpm; leave it exactly as the installer wrote it.
#
# So global packages are updated BY NAME, which keeps the walk away from the
# @pnpm/exe project entirely.
if command -v pnpm &>/dev/null; then
    log "Updating pnpm runtime and global packages..."
    pnpm runtime set node lts -g || warn "pnpm runtime set node lts failed"

    # pnpm itself. A no-op that exits 0 when already on latest.
    pnpm self-update || warn "pnpm self-update failed"

    # Everything the user installed with `pnpm add -g`, minus the entries pnpm
    # manages through the dedicated commands above: @pnpm/exe and node from the
    # installer, plus `pnpm` itself — since pnpm 12, `pnpm self-update` records
    # the new version as a global package named `pnpm` (seen 2026-09-07 with
    # 12.3.4), and feeding that name back to `update -g` fails with the same
    # ERR_PNPM_GLOBAL_PNPM_INSTALL as above. A fresh myshell box has no other
    # globals, so this normally skips.
    pnpm_globals=""
    if command -v jq &>/dev/null; then
        pnpm_globals=$(pnpm ls -g --depth 0 --json 2>/dev/null \
            | jq -r '[.[].dependencies // {} | keys[]] | unique[]?
                     | select(. != "@pnpm/exe" and . != "node" and . != "pnpm")' 2>/dev/null) \
            || pnpm_globals=""
    else
        warn "jq missing — cannot enumerate pnpm globals; skipping their update"
    fi
    if [[ -n "$pnpm_globals" ]]; then
        # --yes auto-approves pnpm 11's build-script prompt non-interactively.
        # Unquoted on purpose: one argument per package.
        # shellcheck disable=SC2086
        pnpm update -g --yes $pnpm_globals || warn "pnpm update -g failed"
    else
        sublog "no user-installed global packages — nothing to update"
    fi

    # Last-resort repair. Only the official installer can rebuild a pnpm that
    # is already the placeholder: in that state the binary cannot run, so
    # self-update is not available to fix itself.
    if ! pnpm --version >/dev/null 2>&1; then
        warn "pnpm is not runnable (placeholder binary) — reinstalling via get.pnpm.io"
        curl -fsSL https://get.pnpm.io/install.sh | SHELL="${SHELL:-$(command -v bash)}" sh - \
            || warn "pnpm reinstall failed"
    fi
fi

# uv and the CLI tools it manages (see the install header's Python rule: uv is
# the only sanctioned Python tool, so these arrive as `uv tool install`, never
# pip or pipx). `uv self update` is for a standalone install only — a
# brew-managed uv refuses it, and `brew upgrade` above already covered it.
if command -v uv &>/dev/null; then
    log "Updating uv and its tools..."
    if command -v brew &>/dev/null && brew list --formula uv >/dev/null 2>&1; then
        sublog "uv is brew-managed — covered by brew upgrade above"
    else
        uv self update || warn "uv self update failed"
    fi
    uv tool upgrade --all || warn "uv tool upgrade --all failed"
fi

# Codex — official OpenAI installer. Rerun only when Codex is already present;
# the installer handles install/upgrade in place and repairs a stale shim.
if command -v codex &>/dev/null; then
    log "Updating OpenAI Codex CLI..."
    curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh || warn "Codex update failed"
fi

# Claude Code — native install (~/.local/bin), self-updates via its own command.
if command -v claude &>/dev/null; then
    log "Updating Claude Code..."
    claude update || warn "Claude Code update failed"
fi

# OpenCode — standalone binary, self-updates via its own command.
if command -v opencode &>/dev/null; then
    log "Upgrading OpenCode..."
    opencode upgrade || warn "OpenCode upgrade failed"
fi

# Antigravity CLI (agy) — standalone binary, self-updates via its own command.
if command -v agy &>/dev/null; then
    log "Updating Antigravity CLI (agy)..."
    agy update || warn "agy update failed"
fi

# CodeGraph — standalone bundle (~/.codegraph), self-updates via its own command.
if command -v codegraph &>/dev/null; then
    log "Upgrading CodeGraph..."
    codegraph upgrade || warn "CodeGraph upgrade failed"
fi

# Claude Code gstack skill — use the skill's own updater (same as /gstack-upgrade).
if [[ -x "$HOME/.claude/skills/gstack/bin/gstack-update-check" ]]; then
    log "Updating Claude gstack skill..."
    "$HOME/.claude/skills/gstack/bin/gstack-update-check" --force || warn "gstack skill update failed"
fi

# Local drop-ins — ~/.config/myshell/update.d/*.sh, in lexical order, last so
# they can lean on the toolchain the sections above just refreshed (git, uv,
# pnpm). scripts/install overwrites THIS file on every bootstrap, so a hand-edit
# here is lost; update.d is the sanctioned place for machine-local steps. The
# installer deploys myshell's own drop-ins there and leaves every other file
# alone, exactly as it treats ~/.zsh.
#
# Sourced, not executed, so a drop-in is simply another section of this script:
# it gets log/sublog/warn, $SUDO/$NO_SUDO, and its warnings reach the Done line
# below. Executing them instead would isolate them, but the WARNINGS counter
# lives in this shell and a child process cannot increment it. Three rules
# follow from sourcing, and the shipped drop-ins document them too:
#   1. `source` runs inside a `|| warn` list, which suspends set -e for the
#      whole file — so guard every step with its own `|| warn`, like the
#      sections above, instead of relying on the ERR trap;
#   2. a drop-in shares this shell, so wrap any `cd` in a subshell — and keep
#      `warn` OUTSIDE that subshell, or its counter increment is lost with the
#      subshell (scripts/install's header calls out the same trap);
#   3. end the file with `true`: the status reported here is whatever ran last,
#      and a guard `if` that didn't match returns 1, which would otherwise be
#      reported as a failed drop-in on every machine that skips it.
UPDATE_D="$HOME/.config/myshell/update.d"
if [[ -d "$UPDATE_D" ]]; then
    for drop_in in "$UPDATE_D"/*.sh; do
        [[ -f "$drop_in" ]] || continue   # unmatched glob stays literal
        # shellcheck disable=SC1090  # runtime path, nothing to follow
        source "$drop_in" || warn "update.d/${drop_in##*/} failed"
    done
fi

if [[ "$WARNINGS" -gt 0 ]]; then
    log "Done with $WARNINGS warning(s) — grep output for 'warning:'."
else
    log "Done."
fi
