#!/usr/bin/env bash
# CI round-trip — runs INSIDE the test environment: an ubuntu container (as
# the sudo-capable user or as root) or directly on a macOS runner. myshell
# is interactive by design, so this seeds every
# recorded answer up front (see the install header's answers rule) to make
# the run headless, runs bootstrap twice — fresh box, then idempotent
# re-run — and asserts the results. Any prompt that slips through dies on
# the missing /dev/tty, which is itself the test.
#
# MYSHELL_CI_AGENTS (default empty = none) can be set to e.g. "claude" to
# also exercise the agent installers.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

run_bootstrap() {
    local label="$1" out="/tmp/ci-$1-out.log" err="/tmp/ci-$1-err.log" warnings
    echo "=== bootstrap: $label ==="
    if ! "$REPO_ROOT/bootstrap" >"$out" 2>"$err"; then
        cat "$out"; cat "$err" >&2
        fail "$label run exited nonzero"
    fi
    cat "$out"; cat "$err" >&2
    warnings=$(grep -c '^warning:' "$err" || true)
    [[ "$warnings" -eq 0 ]] || fail "$label run produced $warnings warning(s)"
}

# Seed every interactive answer: state files for the choose_* questions,
# git config for the identity prompt.
mkdir -p "$HOME/.local/state/myshell"
printf '%s\n' "${MYSHELL_CI_AGENTS:-}" >"$HOME/.local/state/myshell/agents"
printf 'no\n' >"$HOME/.local/state/myshell/fonts"
printf 'no\n' >"$HOME/.local/state/myshell/login-shell"
git config --global user.name  ci
git config --global user.email ci@example.invalid

run_bootstrap fresh

[[ -f "$HOME/.zshenv" ]] || fail "~/.zshenv missing"
[[ -f "$HOME/.zshrc"  ]] || fail "~/.zshrc missing"
[[ -x "$HOME/bin/myshell-update" ]] || fail "~/bin/myshell-update missing"
[[ -d "$HOME/.local/share/zinit/zinit.git" ]] || fail "zinit missing"
[[ -x "$HOME/.local/share/pnpm/bin/pnpm" || -x "$HOME/.local/share/pnpm/pnpm" ]] \
    || fail "standalone pnpm missing"
pnpm_bin="$HOME/.local/share/pnpm/bin/pnpm"
[[ -x "$pnpm_bin" ]] || pnpm_bin="$HOME/.local/share/pnpm/pnpm"
[[ "$("$pnpm_bin" config get strict-dep-builds 2>/dev/null)" == "true" ]] \
    || fail "pnpm strict-dep-builds not pinned"
command -v zsh >/dev/null || fail "zsh missing"
[[ ! -f /etc/dpkg/dpkg.cfg.d/excludes ]] || fail "system still minimized (unminimize did not run)"

run_bootstrap rerun

# Regression (2026-07-04): a converged box must not pre-warm sudo — the rerun
# has nothing system-level left to do, so sudo_work_pending must predict "no
# work" and skip the password prompt. Only observable when running as a
# non-root sudoer (as root the whole warm_sudo path is skipped anyway).
if [[ $EUID -ne 0 ]] && command -v sudo >/dev/null; then
    grep -q 'no system-level changes pending — skipping sudo pre-auth' /tmp/ci-rerun-out.log \
        || fail "rerun pre-warmed sudo: sudo_work_pending predicted work on a converged box"
fi

# Regression (2026-07-04): an unanswered question in a headless run must abort
# loudly — never record a fabricated answer. Only meaningful without a tty
# (in a terminal the prompt would just wait for input, so skip it there).
if ! ( : </dev/tty ) 2>/dev/null; then
    echo "=== bootstrap: no-answer (must abort) ==="
    rm -f "$HOME/.local/state/myshell/agents"
    if "$REPO_ROOT/bootstrap" >/tmp/ci-noanswer-out.log 2>/tmp/ci-noanswer-err.log; then
        cat /tmp/ci-noanswer-out.log; cat /tmp/ci-noanswer-err.log >&2
        fail "headless run with an unanswered question should exit nonzero"
    fi
    grep -q 'cannot read' /tmp/ci-noanswer-err.log \
        || { cat /tmp/ci-noanswer-err.log >&2; fail "expected a clear cannot-read-terminal error"; }
    [[ ! -f "$HOME/.local/state/myshell/agents" ]] \
        || fail "aborted run recorded an answer it never asked"
    printf '%s\n' "${MYSHELL_CI_AGENTS:-}" >"$HOME/.local/state/myshell/agents"
else
    echo "skipping no-answer test (a tty is attached — the prompt would block)"
fi

echo "CI round-trip OK"
