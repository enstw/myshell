#!/usr/bin/env bash
# CI round-trip — runs INSIDE the test environment: an ubuntu container (as
# the sudo-capable user or as root) or directly on a macOS runner. myshell
# is interactive by design, so this seeds every
# recorded answer up front (see the install header's answers rule) to make
# the run headless, runs bootstrap twice — fresh box, then idempotent
# re-run — and asserts the results. Any prompt that slips through dies on
# the missing /dev/tty, which is itself the test.
#
# MYSHELL_CI_AGENTS (default empty = none) selects agents to install, and is
# the only thing that exercises the agent installers at all — the sudo-user
# job sets it to "claude". Left empty everywhere else on purpose: the other
# jobs then assert the opposite, that an unselected agent is NOT installed,
# which is what makes "none really means none" a tested promise rather than a
# comment.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

run_bootstrap() {
    local label="$1" out="/tmp/ci-$1-out.log" err="/tmp/ci-$1-err.log" warnings
    echo "=== bootstrap: $label ==="
    if ! "$REPO_ROOT/bootstrap" >"$out" 2>"$err"; then
        cat "$out"; cat "$err" >&2
        fail "$label run exited nonzero"
    fi
    cat "$out"; cat "$err" >&2
    warnings=$(grep -c '^warning:' "$err" || true)
    [[ "$warnings" -eq 0 ]] || fail "$label run produced $warnings warning(s)"
}

# Seed every interactive answer: state files for the choose_* questions,
# git config for the identity prompt.
mkdir -p "$HOME/.local/state/myshell"
printf '%s\n' "${MYSHELL_CI_AGENTS:-}" >"$HOME/.local/state/myshell/agents"
printf 'no\n' >"$HOME/.local/state/myshell/fonts"
# 'yes', not 'no': answering no skips set_login_shell's chsh entirely, and that
# blind spot is exactly how the 2026-08-31 curl|sh chsh bug shipped. The
# environments here are the ones that must work unattended (root container,
# NOPASSWD sudoer, macOS runner), so let the step run and assert it below.
printf 'yes\n' >"$HOME/.local/state/myshell/login-shell"
git config --global user.name  ci
git config --global user.email ci@example.invalid

run_bootstrap fresh

[[ -f "$HOME/.zshenv" ]] || fail "~/.zshenv missing"
[[ -f "$HOME/.zshrc"  ]] || fail "~/.zshrc missing"
[[ -x "$HOME/bin/myshell-update" ]] || fail "~/bin/myshell-update missing"
[[ -d "$HOME/.local/share/zinit/zinit.git" ]] || fail "zinit missing"
[[ -x "$HOME/.local/share/pnpm/bin/pnpm" || -x "$HOME/.local/share/pnpm/pnpm" ]] \
    || fail "standalone pnpm missing"
pnpm_bin="$HOME/.local/share/pnpm/bin/pnpm"
[[ -x "$pnpm_bin" ]] || pnpm_bin="$HOME/.local/share/pnpm/pnpm"
[[ "$("$pnpm_bin" config get strict-dep-builds 2>/dev/null)" == "true" ]] \
    || fail "pnpm strict-dep-builds not pinned"
command -v zsh >/dev/null || fail "zsh missing"

# Regression (2026-08-31): the chsh step must actually change the login shell,
# unattended. It used to let PAM read its password prompt from stdin — which in
# curl|sh mode is the already-consumed script pipe, so it hit EOF, died "PAM:
# Authentication failure", and tripped the ERR trap as the very last command of
# the run: everything installed, login shell still bash, no Done line.
login_shell() {
    if [[ "$(uname -s)" == Darwin ]]; then
        dscl . -read "/Users/$(id -un)" UserShell 2>/dev/null | awk '{print $2}'
    else
        getent passwd "$(id -un)" | cut -d: -f7
    fi
}
[[ "$(login_shell)" == */zsh ]] || fail "login shell not zsh after fresh run: $(login_shell)"
[[ -x "$HOME/.local/bin/codegraph" ]] || fail "codegraph missing"

# Agent installers. install_agents is keyed on the RECORDED answer, not on
# which binaries happen to be present, so both directions are worth asserting.
if [[ ",${MYSHELL_CI_AGENTS:-}," == *,claude,* ]]; then
    [[ -x "$HOME/.local/bin/claude" ]] \
        || fail "claude was selected but is not in ~/.local/bin"
    grep -q 'selected: .*claude' /tmp/ci-fresh-out.log \
        || fail "install_agents did not report claude as selected"
else
    # "none really means none": an empty answer must install nothing, and must
    # not be re-read as "ask again" or "install the default".
    [[ ! -e "$HOME/.local/bin/claude" ]] \
        || fail "claude installed without being selected"
fi

# Regression (2026-08-31/09-01): the MOTD is PAM's job alone. pam_motd
# (/etc/pam.d/sshd, /etc/pam.d/login) already prints it once per login
# session, so zsh printing it too doubled it on every SSH login — visible only
# once the chsh fix above actually made zsh the login shell. The drop-in is
# gone entirely rather than guarded, so assert it stays gone.
[[ ! -e "$HOME/.zsh/motd.zsh" ]] \
    || fail "~/.zsh/motd.zsh exists — the MOTD belongs to pam_motd, not to zsh"
[[ ! -f /etc/dpkg/dpkg.cfg.d/excludes ]] || fail "system still minimized (unminimize did not run)"

# ...and a box that already has the file from an older install must lose it
# on the next run, not keep printing a second banner forever.
printf 'echo stale\n' >"$HOME/.zsh/motd.zsh"

run_bootstrap rerun

# The agent installers must be check-first like every other step: a converged
# box re-downloads nothing. Claude Code self-updates, so a reinstall here
# would also be fighting its own updater.
if [[ ",${MYSHELL_CI_AGENTS:-}," == *,claude,* ]]; then
    grep -q 'already installed (~/.local/bin/claude) — skipping' /tmp/ci-rerun-out.log \
        || fail "claude was reinstalled on a converged box"
fi

[[ ! -e "$HOME/.zsh/motd.zsh" ]] \
    || fail "a pre-existing ~/.zsh/motd.zsh survived a re-run"

# Regression (2026-07-04): a converged box must not pre-warm sudo — the rerun
# has nothing system-level left to do, so sudo_work_pending must predict "no
# work" and skip the password prompt. Only observable when running as a
# non-root sudoer (as root the whole warm_sudo path is skipped anyway).
if [[ $EUID -ne 0 ]] && command -v sudo >/dev/null; then
    grep -q 'no system-level changes pending — skipping sudo pre-auth' /tmp/ci-rerun-out.log \
        || fail "rerun pre-warmed sudo: sudo_work_pending predicted work on a converged box"
fi

# Regression (2026-07-04): an unanswered question in a headless run must abort
# loudly — never record a fabricated answer. Only meaningful without a tty
# (in a terminal the prompt would just wait for input, so skip it there).
if ! ( : </dev/tty ) 2>/dev/null; then
    echo "=== bootstrap: no-answer (must abort) ==="
    rm -f "$HOME/.local/state/myshell/agents"
    if "$REPO_ROOT/bootstrap" >/tmp/ci-noanswer-out.log 2>/tmp/ci-noanswer-err.log; then
        cat /tmp/ci-noanswer-out.log; cat /tmp/ci-noanswer-err.log >&2
        fail "headless run with an unanswered question should exit nonzero"
    fi
    grep -q 'cannot read' /tmp/ci-noanswer-err.log \
        || { cat /tmp/ci-noanswer-err.log >&2; fail "expected a clear cannot-read-terminal error"; }
    [[ ! -f "$HOME/.local/state/myshell/agents" ]] \
        || fail "aborted run recorded an answer it never asked"
    printf '%s\n' "${MYSHELL_CI_AGENTS:-}" >"$HOME/.local/state/myshell/agents"
else
    echo "skipping no-answer test (a tty is attached — the prompt would block)"
fi

# Phases (2026-08-31): stage 2 is a list of phases and --phase runs a subset.
# Exercised here on the converged box, which is what --phase is for.
echo "=== phases ==="
phase_list=$("$REPO_ROOT/scripts/install" --list-phases)
for p in system shell fonts packages runtimes agents; do
    grep -q "^  $p " <<<"$phase_list" || fail "--list-phases omits $p"
done
if "$REPO_ROOT/scripts/install" --phase nosuchphase >/dev/null 2>/tmp/ci-badphase-err.log; then
    fail "an unknown --phase should exit nonzero"
fi
grep -q 'unknown phase' /tmp/ci-badphase-err.log \
    || { cat /tmp/ci-badphase-err.log >&2; fail "expected a clear unknown-phase error"; }

# A subset must run exactly the phases asked for, and stay clean doing it.
if ! "$REPO_ROOT/scripts/install" --phase fonts >/tmp/ci-phase-out.log 2>/tmp/ci-phase-err.log; then
    cat /tmp/ci-phase-out.log; cat /tmp/ci-phase-err.log >&2
    fail "--phase fonts exited nonzero"
fi
cat /tmp/ci-phase-out.log; cat /tmp/ci-phase-err.log >&2
grep -q '\[3/6\] fonts' /tmp/ci-phase-out.log || fail "--phase fonts did not run the fonts phase"
! grep -q '\[2/6\] shell' /tmp/ci-phase-out.log || fail "--phase fonts also ran the shell phase"
[[ "$(grep -c '^warning:' /tmp/ci-phase-err.log || true)" -eq 0 ]] \
    || fail "--phase fonts produced warnings"

echo "CI round-trip OK"
