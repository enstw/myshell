#!/usr/bin/env bash
# Static gate — syntax-check all three scripts and verify the output-helper
# blocks are byte-identical (the install header rule says drift between the
# copies is a bug; this makes the rule mechanical). Run it locally before
# committing; CI runs it as its first job.
#
# --fix: on drift, rewrite the block in scripts/install and
# scripts/myshell-update from bootstrap's copy instead of failing. bootstrap
# is canonical because its copy must stay POSIX-sh-safe, and POSIX sh is
# valid bash — syncing that direction can never break the bash scripts.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

fix=0
[[ "${1:-}" == "--fix" ]] && fix=1

sh   -n bootstrap
bash -n scripts/install
bash -n scripts/myshell-update
bash -n scripts/ci-roundtrip
bash -n scripts/test-prompts
# update.d drop-ins are sourced by myshell-update, so a syntax error in one
# only surfaces at `u` time on whatever machine has it deployed. Gate them here.
for drop_in in update.d/*.sh; do
    [[ -f "$drop_in" ]] || continue
    bash -n "$drop_in"
done
echo "syntax: ok"

block() { sed -n '/^WARNINGS=0$/,/^die()/p' "$1"; }
ref=$(block bootstrap)
[[ -n "$ref" ]] || { echo "error: output-helper block not found in bootstrap" >&2; exit 1; }
for f in scripts/install scripts/myshell-update; do
    [[ "$(block "$f")" == "$ref" ]] && continue
    if [[ "$fix" == 1 ]]; then
        # ENVIRON, not awk -v: -v escape-processes backslashes, which would
        # mangle the literal \n inside the block's printf formats.
        REF="$ref" awk '
            /^WARNINGS=0$/ && !synced { print ENVIRON["REF"]; synced=1; skip=1; next }
            skip { if (/^die\(\)/) skip=0; next }
            { print }
        ' "$f" >"$f.fix.tmp"
        cat "$f.fix.tmp" >"$f"   # cat-over, not mv: keeps the exec bit
        rm "$f.fix.tmp"
        bash -n "$f"
        [[ "$(block "$f")" == "$ref" ]] \
            || { echo "error: $f still differs after --fix" >&2; exit 1; }
        echo "synced output-helper block in $f from bootstrap"
        continue
    fi
    echo "error: output-helper block in $f differs from bootstrap (header rule: byte-identical)" >&2
    diff <(printf '%s\n' "$ref") <(block "$f") >&2 || true
    echo "hint: scripts/check --fix rewrites the copies from bootstrap's" >&2
    exit 1
done
echo "output-helper blocks: byte-identical"

# The myshell repo URL is spelled in three places for the same reason the
# output helpers are duplicated: bootstrap runs before any checkout exists and
# myshell-update is deployed standalone to ~/bin, so no sourced constant can
# reach all three. Drift means the self-update section would check one repo and
# install another, so pin them to each other here.
url_of() { sed -n "s/^$2=\"\(.*\)\"\$/\1/p" "$1" | head -1; }
tarball_bootstrap=$(url_of bootstrap REPO_TARBALL)
tarball_update=$(url_of scripts/myshell-update MYSHELL_TARBALL)
clone_install=$(url_of scripts/install MYSHELL_REPO_URL)
clone_update=$(url_of scripts/myshell-update MYSHELL_REPO_URL)
[[ -n "$tarball_bootstrap" && "$tarball_bootstrap" == "$tarball_update" ]] \
    || { echo "error: tarball URL differs — bootstrap:'$tarball_bootstrap' myshell-update:'$tarball_update'" >&2; exit 1; }
[[ -n "$clone_install" && "$clone_install" == "$clone_update" ]] \
    || { echo "error: clone URL differs — install:'$clone_install' myshell-update:'$clone_update'" >&2; exit 1; }
# ...and the two URL shapes must name the same repo.
[[ "${tarball_bootstrap%/archive/*}" == "${clone_install%.git}" ]] \
    || { echo "error: tarball and clone URLs name different repos: '$tarball_bootstrap' vs '$clone_install'" >&2; exit 1; }
echo "myshell repo URLs: consistent"

echo "ok"
